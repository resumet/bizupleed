# 로컬 개발은 아무 값 없이도 동작한다(내장 Postgres + 로컬 디스크).
# Vercel 배포 시 아래 값을 Project Settings → Environment Variables 에 등록한다.

# ── Supabase Postgres ──────────────────────────────────────────
# Supabase → Connect → "Transaction pooler" (포트 6543) 연결 문자열. 서버리스(Vercel)에서는 반드시 풀러 주소를 쓴다.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# 인스턴스당 최대 연결 수(기본 3)
# DB_POOL_MAX=3

# ── Supabase Storage (업로드 이미지) ────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
# service_role 키는 서버 전용이다. NEXT_PUBLIC_ 접두사를 붙이지 말 것.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=uploads

# ── 보안 ───────────────────────────────────────────────────────
# 연락처 암호화·해시 키. 운영에서는 필수이며, 잃어버리면 저장된 연락처를 복호화할 수 없다. (예: openssl rand -hex 32)
APP_SECRET=
# /api/cron/tick 보호. Vercel Cron 은 이 값을 Authorization: Bearer 헤더로 자동 전송한다.
CRON_SECRET=
# /api/webhooks/* 활성화(x-webhook-secret 헤더)
# WEBHOOK_SECRET=

# ── 선택 ───────────────────────────────────────────────────────
# 설정하면 Claude 가 기획서·수정·개선 제안을 생성한다. 없으면 규칙 기반 템플릿으로 동작한다.
# ANTHROPIC_API_KEY=
# 기본 mock(모의 결제). 실제 PG 를 붙이면 다른 값으로 바꿔 모의 결제 버튼을 끈다.
# PAYMENT_PROVIDER=mock
